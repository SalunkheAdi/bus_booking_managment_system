{
  "name": "bus-booking-management-system",
  "version": "1.0.0",
  "description": "Bus Booking Management System - Modular Monolith with RBAC, Seat Integrity, Cancellation, Manifest & Reporting",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "seed": "node backend/src/db/seed.js",
    "test": "jest --runInBand --detectOpenHandles",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build": "cd frontend && npm install && npm run build",
    "dev": "node backend/src/server.js"
  },
  "engines": {
    "node": ">=20.x"
  },
  "keywords": [
    "bus-booking",
    "seat-management",
    "concurrency",
    "rbac",
    "express",
    "sqlite"
  ],
  "author": "Student Developer",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000
  }
}
